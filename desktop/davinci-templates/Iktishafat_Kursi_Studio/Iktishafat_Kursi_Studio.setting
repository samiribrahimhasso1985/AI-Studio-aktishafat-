				HelpPage = "Iktishafat Kursi Studio v1.0 - Schnitt-Stufen-Rahmen (Telefon + Stufenleiste Raw/CC/Text/Animation/SFX). 30fps, 9:16. Quelle: Analyse 521882.mp4",
			},
			Inputs = ordered() {
