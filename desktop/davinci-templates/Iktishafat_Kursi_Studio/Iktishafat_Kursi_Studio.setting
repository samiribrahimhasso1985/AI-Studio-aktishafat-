				CrossFrame = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_MinScale = 0, INP_MaxScale = 1000, INP_Default = 139.5, LINKS_Name = "Frame: Grenze Stufe 1|2 am Marker", },
				CrossY = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_MinScale = 0, INP_MaxScale = 1, INP_Default = 0, LINKS_Name = "(intern)", },
				LabelY = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_MinScale = 0, INP_MaxScale = 1, INP_Default = 0.178, LINKS_Name = "Beschriftung Hoehe", },
				IntroFrames = { LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_MinScale = 0, INP_MaxScale = 30, INP_Default = 8, LINKS_Name = "Einblenden (Frames)", },
